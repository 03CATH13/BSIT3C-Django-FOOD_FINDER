                ]},
                { name: "Infinitea", mapQuery: "Infinitea+Kabankalan", rating: "4.5", price: "₱80–₱130", img: "https://images.unsplash.com/photo-1544787219-7f47ccb76574?q=80&w=800&auto=format&fit=crop", address: "City Proper, Kabankalan", menu: [
                    { name: "Hokkaido", price: "₱95", desc: "Creamy milk tea", img: "https://images.unsplash.com/photo-1525803377221-4f6ccdaa5133?q=80&w=200&auto=format&fit=crop" }
                ]}
            ]
        };

        const trendingData = [
            foodData.fastfood.find(item => item.name === "Jollibee (Guanzon)"),
            foodData.fastfood.find(item => item.name === "Mang Inasal (Gaisano)"),
            foodData.carinderia.find(item => item.name === "Kabankalan Ihaw-Ihaw"),
            foodData.carinderia.find(item => item.name === "ALONSO's Cansi"),
            foodData.cafe.find(item => item.name === "Taza La Bien"),
            foodData.desserts.find(item => item.name === "Bibingka Station"),
            foodData.milktea.find(item => item.name === "Chatime (City Mall)"),
            foodData.milktea.find(item => item.name === "Macao Imperial Tea")
        ];

        const categoryList = document.getElementById('category-list');
        const trendingGrid = document.getElementById('trending-grid');
        const allRestaurantsGrid = document.getElementById('all-restaurants-grid');
        const categoryTitle = document.getElementById('category-title');
        const trendingTitle = document.getElementById('trending-title');
        const buttons = categoryList.querySelectorAll('.cat-btn');
        const searchInput = document.getElementById('searchInput');
        const searchBtn = document.getElementById('searchBtn');
        
        const categoriesSection = document.getElementById('categoriesSection');
        const trendingSection = document.getElementById('trendingSection');

        const infoModal = document.getElementById('infoModal');
        const modalRestaurantName = document.getElementById('modalRestaurantName');
        const modalMenuList = document.getElementById('modalMenuList');
        const modalAddress = document.getElementById('modalAddress');
        const mapFrame = document.getElementById('mapFrame');
        const openMapsBtn = document.getElementById('openMapsBtn');
        const mapBadgeLink = document.getElementById('mapBadgeLink');

        // Default active category
        let currentCategory = 'carinderia';

        function createTrendingCardHTML(item) {
            return `
                <div class="card-img" style="background-image: url('${item.img}');"></div>
                <div class="card-content">
                    <h3>${item.name}</h3>
                    <div class="rating"><i class="fas fa-star"></i> ${item.rating}</div>
                </div>
            `;
        }

        function createAllCardHTML(item) {
            return `
                <div class="card-img" style="background-image: url('${item.img}');"></div>
                <div class="card-content">
                    <div class="header-row">
                        <h3>${item.name}</h3>
                        <div class="rating"><i class="fas fa-star"></i> ${item.rating}</div>
                    </div>
                    <div class="price">${item.price}</div>
                    <button class="btn-primary">
                        <i class="fas fa-utensils"></i> View Menu
                    </button>
                </div>
            `;
        }

        function renderTrending(isSearch = false, searchResults = []) {
            let itemsToRender = isSearch ? searchResults : trendingData;
            trendingGrid.innerHTML = '';

            if (itemsToRender.length === 0) {
                trendingGrid.innerHTML = `<div class="empty-state"><h3>Wala sang nakita</h3></div>`;
                return;
            }

            itemsToRender.forEach(item => {
                const card = document.createElement('div');
                card.className = 'trending-card'; 
                card.setAttribute('onclick', `openModal("${item.name}")`); 
                card.innerHTML = createTrendingCardHTML(item);
                trendingGrid.appendChild(card);
            });
        }

        function renderCategory(categoryKey, categoryName, searchQuery = "") {
            let items = foodData[categoryKey] || [];

            if (searchQuery.trim() !== "") {
                items = items.filter(item => item.name.toLowerCase().includes(searchQuery.toLowerCase()));
            }

            categoryTitle.innerHTML = `<i class="fas fa-list" style="color: var(--primary);"></i> All ${categoryName}`;
            
            allRestaurantsGrid.innerHTML = '';

            if (items.length === 0) {
                allRestaurantsGrid.innerHTML = `
                    <div class="empty-state">
                        <i class="fas fa-search"></i>
                        <h3>Wala sang nakita</h3>
                        <p>Wala kami makita nga "${searchQuery}" sa sini nga category.</p>
                    </div>
                `;
                return;
            }

            items.forEach(item => {
                const card = document.createElement('div');
                card.className = 'all-card'; 
                card.setAttribute('onclick', `openModal("${item.name}")`); 
                card.innerHTML = createAllCardHTML(item);
                allRestaurantsGrid.appendChild(card);
            });
        }

        function isSimilar(word1, word2) {
            if (word2.includes(word1) || word1.includes(word2)) return true;
            const track = Array(word2.length + 1).fill(null).map(() => Array(word1.length + 1).fill(null));
            for (let i = 0; i <= word1.length; i += 1) track[0][i] = i;
            for (let j = 0; j <= word2.length; j += 1) track[j][0] = j;
            for (let j = 1; j <= word2.length; j += 1) {
                for (let i = 1; i <= word1.length; i += 1) {
                    const indicator = word1[i - 1] === word2[j - 1] ? 0 : 1;
                    track[j][i] = Math.min(track[j][i - 1] + 1, track[j - 1][i] + 1, track[j - 1][i - 1] + indicator);
                }
            }
            return track[word2.length][word1.length] <= 2; 
        }

        function handleSearch(query) {
            if (query.trim() !== "") {
                categoriesSection.classList.add('hide-on-search');
                trendingSection.classList.add('hide-on-search');
                
                document.querySelector('.content-split').style.gridTemplateColumns = '1fr';
                
                categoryTitle.innerHTML = `<i class="fas fa-search" style="color: var(--primary);"></i> Search Results for "${query}"`;
                trendingTitle.innerHTML = `<i class="fas fa-search" style="color: var(--primary);"></i> Search Results for "${query}"`;
                
                const searchTerm = query.toLowerCase().trim();
                let allResults = [];
                const searchWords = searchTerm.split(' ').filter(w => w.length > 0);

                for (let key in foodData) {
                    const filtered = foodData[key].filter(item => {
                        let searchString = `${item.name} ${item.address} ${item.price}`;
                        if (item.menu) {
                            item.menu.forEach(m => { searchString += ` ${m.name} ${m.desc}`; });
                        }
                        const itemWords = searchString.toLowerCase().split(/[\s,.-]+/);
                        return searchWords.every(searchWord => 
                            itemWords.some(itemWord => isSimilar(searchWord, itemWord))
                        );
                    });
                    allResults = allResults.concat(filtered);
                }
                
                allRestaurantsGrid.innerHTML = '';
                if (allResults.length === 0) {
                    allRestaurantsGrid.innerHTML = `<div class="empty-state"><h3>Wala sang nakita</h3></div>`;
                } else {
                    allResults.forEach(item => {
                        const card = document.createElement('div');
                        card.className = 'all-card';
                        card.setAttribute('onclick', `openModal("${item.name}")`); 
                        card.innerHTML = createAllCardHTML(item);
                        allRestaurantsGrid.appendChild(card);
                    });
                }
            } else {
                categoriesSection.classList.remove('hide-on-search');
                trendingSection.classList.remove('hide-on-search');
                document.querySelector('.content-split').style.gridTemplateColumns = '1fr 1fr';

                trendingTitle.innerHTML = `<i class="fas fa-fire" style="color: #e67e22;"></i> Trending`;
                
                renderTrending(); 
                
                const activeBtn = document.querySelector('.cat-btn.active');
                const catName = activeBtn ? activeBtn.innerText.trim() : 'Local & Cansi';
                renderCategory(currentCategory, catName);
            }
        }

        buttons.forEach(btn => {
            btn.addEventListener('click', function() {
                buttons.forEach(b => b.classList.remove('active'));
                this.classList.add('active');
                
                currentCategory = this.dataset.category;
                const categoryName = this.innerText.trim();
                
                searchInput.value = ""; 
                
                categoriesSection.classList.remove('hide-on-search');
                trendingSection.classList.remove('hide-on-search');
                document.querySelector('.content-split').style.gridTemplateColumns = '1fr 1fr';

                trendingTitle.innerHTML = `<i class="fas fa-fire" style="color: #e67e22;"></i> Trending`;
                
                renderTrending(); 
                renderCategory(currentCategory, categoryName);
            });
        });

        searchBtn.addEventListener('click', function() {
            handleSearch(searchInput.value);
        });

        searchInput.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                handleSearch(this.value);
            }
        });

        searchInput.addEventListener('input', function() {
            if (this.value.trim() === "") {
                handleSearch(""); 
            }
        });

        function openModal(restaurantName) {
            let foundRestaurant = null;
            for (let key in foodData) {
                const found = foodData[key].find(item => item.name === restaurantName);
                if (found) { foundRestaurant = found; break; }
            }

            if (foundRestaurant) {
                modalRestaurantName.textContent = foundRestaurant.name;
                
                modalMenuList.innerHTML = '';
                if (foundRestaurant.menu) {
                    foundRestaurant.menu.forEach(menuItem => {
                        const div = document.createElement('div');
                        div.className = 'menu-item';
                        div.innerHTML = `
                            <div class="menu-item-img" style="background-image: url('${menuItem.img || 'https://images.unsplash.com/photo-1546069901-ba9599a7e63c?q=80&w=200&auto=format&fit=crop'}');"></div>
                            <div class="menu-item-details">
                                <div class="menu-item-info">
                                    <h5>${menuItem.name}</h5>
                                    <p>${menuItem.desc}</p>
                                </div>
                            </div>
                            <div class="menu-item-price">${menuItem.price}</div>
                        `;
                        modalMenuList.appendChild(div);
                    });
                } else {
                    modalMenuList.innerHTML = '<p class="text-muted">No menu available.</p>';
                }

                modalAddress.textContent = foundRestaurant.address || 'Address not available';
                
                if (foundRestaurant.mapQuery) {
                    mapFrame.src = `https://maps.google.com/maps?q=${foundRestaurant.mapQuery}&t=&z=18&ie=UTF8&iwloc=&output=embed`;
                    openMapsBtn.href = `https://www.google.com/maps/search/?api=1&query=${foundRestaurant.mapQuery}`;
                    mapBadgeLink.href = `https://www.google.com/maps/search/?api=1&query=${foundRestaurant.mapQuery}`;
                } else {
                    mapFrame.src = "";
                    openMapsBtn.href = "#";
                    mapBadgeLink.href = "#";
                }

                infoModal.classList.add('active');
            } else {
                alert("Wala sang detalye nga available.");
            }
        }

        function closeModal() {
            infoModal.classList.remove('active');
            mapFrame.src = ""; 
        }

        infoModal.addEventListener('click', function(e) {
            if (e.target === infoModal) closeModal();
        });

        const reviewForm = document.getElementById('reviewForm');
        const reviewList = document.getElementById('reviewList');
        const reviewText = document.getElementById('reviewText');
        const submitBtn = document.getElementById('submitBtn');

        reviewForm.addEventListener('submit', function(e) {
            e.preventDefault(); 
            const name = document.getElementById('reviewName').value;
            const rating = document.getElementById('reviewRating').value;
            const text = reviewText.value;
            let stars = ''; for (let i = 0; i < rating; i++) stars += '⭐';
            const date = new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
            const newReview = document.createElement('div');
            newReview.className = 'review-item';
            newReview.innerHTML = `
                <div class="review-header">
                    <span class="review-name">${name}</span>
                    <span class="review-stars">${stars}</span>
                </div>
                <p class="review-text">${text}</p>
                <span class="review-date">${date}</span>
            `;
            reviewList.prepend(newReview);
            reviewForm.reset();
        });

        reviewText.addEventListener('keydown', function(e) {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault(); 
                submitBtn.click();  
            }
        });

        // Default Load
        renderTrending();
        renderCategory('carinderia', 'Local & Cansi'); // Naka-set sa Local & Cansi sa umpisa
    </script>

</body>
</html>