<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kabankalan City Proper Food Finder</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        :root {
            --bg-dark: #0f0f13;
            --card-bg: #1c1c24;
            --modal-bg: #1e1e26;
            --primary: #ff4757;
            --text-light: #ffffff;
            --text-muted: #a4b0be;
            --border-color: #2d2d35;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: var(--bg-dark);
            color: var(--text-light);
            line-height: 1.6;
            scrollbar-width: thin;
            scrollbar-color: var(--primary) var(--bg-dark);
        }

        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: var(--bg-dark); }
        ::-webkit-scrollbar-thumb { background: var(--border-color); border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: var(--primary); }

        a { text-decoration: none; color: inherit; }

        /* Navbar */
        .navbar {
            background: rgba(15, 15, 19, 0.95);
            backdrop-filter: blur(10px);
            padding: 15px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 100;
            border-bottom: 1px solid var(--border-color);
        }

        .navbar h2 { color: var(--primary); font-weight: 700; font-size: 1.5rem; }

        .nav-actions { display: flex; align-items: center; gap: 20px; }
        
        .nav-icon {
            color: var(--text-light);
            font-size: 1.2rem;
            transition: color 0.3s;
            position: relative;
        }
        .nav-icon:hover { color: var(--primary); }
        
        .cart-badge {
            position: absolute; top: -5px; right: -8px;
            background: var(--primary); font-size: 0.6rem;
            padding: 2px 5px; border-radius: 50%; font-weight: bold;
        }

        .container { padding: 40px; max-width: 1400px; margin: 0 auto; }

        /* Hero Section */
        .hero {
            text-align: center; padding: 60px 20px 80px;
            background: linear-gradient(135deg, #1c1c24 0%, #2a2a35 100%);
            border-radius: 25px; margin-bottom: -40px;
            border: 1px solid var(--border-color); position: relative; z-index: 1;
            transition: all 0.3s ease;
        }

        .hero h1 {
            font-size: 2.5rem; margin-bottom: 10px;
            background: linear-gradient(to right, #ff4757, #ff7f50);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
        }

        .search-box { position: relative; max-width: 600px; margin: 20px auto 0; }

        .search-box input {
            width: 100%; padding: 18px 25px; padding-right: 120px;
            border-radius: 50px; border: 1px solid #3d3d4a;
            background: #141419; color: white; font-size: 1rem; outline: none;
            transition: border 0.3s;
        }
        
        .search-box input:focus { border-color: var(--primary); }

        .search-box button {
            position: absolute; right: 5px; top: 5px; bottom: 5px;
            background: var(--primary); color: white; border: none;
            padding: 0 30px; border-radius: 50px; font-weight: 600; cursor: pointer;
        }

        /* Sections */
        .section-title { font-size: 1.5rem; margin: 40px 0 20px; display: flex; align-items: center; gap: 10px; justify-content: center; }

        /* Categories */
        .categories {
            display: flex; gap: 15px; padding-bottom: 10px; scrollbar-width: none;
            justify-content: center;
            flex-wrap: wrap;
            transition: all 0.3s ease;
        }

        @media (max-width: 900px) {
            .categories { justify-content: flex-start; flex-wrap: nowrap; overflow-x: auto; }
        }

        .cat-btn {
            padding: 12px 25px; border-radius: 30px; border: 1px solid var(--border-color);
            background: var(--card-bg); color: var(--text-light);
            font-weight: 500; cursor: pointer; transition: all 0.3s;
            display: flex; align-items: center; gap: 8px; white-space: nowrap;
        }

        .cat-btn:hover, .cat-btn.active {
            border-color: var(--primary); background: rgba(255, 71, 87, 0.1);
            color: var(--primary);
        }

        /* DUAL COLUMN LAYOUT */
        .content-split {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 30px;
            margin-top: 20px;
            transition: all 0.3s ease;
        }

        @media (max-width: 1024px) {
            .content-split { grid-template-columns: 1fr; }
        }

        .hide-on-search {
            display: none !important;
        }

        /* TRENDING CARDS */
        .trending-grid { 
            display: grid; 
            grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
            gap: 8px; 
        }

        .trending-card {
            background: var(--card-bg); border-radius: 8px; overflow: hidden;
            border: 1px solid var(--border-color); transition: 0.3s; cursor: pointer;
            display: flex; flex-direction: column;
        }

        .trending-card:hover { 
            transform: translateY(-3px); 
            border-color: rgba(255, 71, 87, 0.4);
            box-shadow: 0 5px 15px rgba(0,0,0,0.3);
        }

        .trending-card .card-img { height: 70px; background-size: cover; background-position: center; }
        .trending-card .card-content { padding: 6px; flex-grow: 1; display: flex; flex-direction: column; justify-content: center; text-align: center; }
        .trending-card h3 { font-size: 0.65rem; margin: 0; line-height: 1.1; color: #fff; }
        .trending-card .rating { color: #f1c40f; font-size: 0.55rem; font-weight: 600; margin-top: 2px; }

        /* ALL CATEGORY CARDS */
        .all-grid { 
            display: grid; 
            grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
            gap: 20px; 
        }

        .all-card {
            background: var(--card-bg); border-radius: 15px; overflow: hidden;
            border: 1px solid var(--border-color); transition: 0.3s; cursor: pointer;
            display: flex; flex-direction: column;
        }

        .all-card:hover { 
            transform: translateY(-5px); 
            border-color: rgba(255, 71, 87, 0.4);
            box-shadow: 0 10px 20px rgba(0,0,0,0.3);
        }

        .all-card .card-img { height: 140px; background-size: cover; background-position: center; }
        .all-card .card-content { padding: 15px; flex-grow: 1; display: flex; flex-direction: column; }
        .all-card h3 { font-size: 1rem; margin: 0 0 5px 0; line-height: 1.2; }
        .all-card .rating { color: #f1c40f; font-size: 0.8rem; font-weight: 600; display: flex; align-items: center; gap: 3px;}
        .all-card .price { color: var(--text-muted); font-size: 0.75rem; margin-bottom: 15px; }
        .all-card .btn-primary { padding: 8px; font-size: 0.8rem; margin-top: auto; border-radius: 8px; }

        /* Shared Button */
        .btn-primary {
            text-align: center; background: var(--primary); color: white;
            border: none; cursor: pointer; font-family: inherit;
            display: flex; align-items: center; justify-content: center; gap: 5px;
        }

        /* SYSTEM FEEDBACK SECTION */
        .reviews-container {
            max-width: 600px; margin: 60px auto; 
            background: linear-gradient(135deg, #1c1c24 0%, #15151a 100%);
            padding: 25px; border-radius: 20px; border: 1px solid var(--border-color);
            box-shadow: 0 15px 40px rgba(0,0,0,0.5);
        }

        .review-form { 
            display: flex; flex-direction: column; gap: 12px; margin-bottom: 25px; 
            background: rgba(255, 255, 255, 0.02); padding: 15px;
            border-radius: 15px; border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .form-row { display: flex; gap: 10px; flex-wrap: wrap; }

        .review-form input, .review-form select, .review-form textarea {
            width: 100%; padding: 10px 14px; background: #141419;
            border: 1px solid var(--border-color); border-radius: 8px;
            color: white; font-family: inherit; font-size: 0.85rem; transition: all 0.3s ease;
        }

        .review-form input:focus, .review-form select:focus, .review-form textarea:focus { 
            outline: none; border-color: var(--primary); box-shadow: 0 0 10px rgba(255, 71, 87, 0.2);
        }

        .review-form textarea { resize: vertical; min-height: 70px; }

        .review-form select {
            appearance: none; -webkit-appearance: none;
            background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23a4b0be' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
            background-repeat: no-repeat; background-position: right 10px center; background-size: 12px; cursor: pointer;
        }

        #submitBtn { 
            padding: 10px; border-radius: 8px; font-size: 0.9rem; font-weight: 600; transition: all 0.3s ease;
            background: linear-gradient(135deg, #ff4757 0%, #ff6b81 100%); box-shadow: 0 4px 12px rgba(255, 71, 87, 0.3); margin-top: 5px;
        }

        #submitBtn:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(255, 71, 87, 0.5); }

        .review-list { display: flex; flex-direction: column; gap: 12px; }

        .review-item {
            background: #141419; padding: 15px; border-radius: 10px; border-left: 4px solid var(--primary);
            box-shadow: 0 4px 15px rgba(0,0,0,0.2); transition: transform 0.2s ease;
        }

        .review-item:hover { transform: translateX(5px); }

        .review-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
        .review-name { font-weight: 600; color: #fff; font-size: 0.9rem; }
        .review-stars { color: #f1c40f; font-size: 0.75rem; background: rgba(241, 196, 15, 0.1); padding: 2px 8px; border-radius: 20px; }
        .review-text { color: #d1d8e0; font-size: 0.85rem; margin-bottom: 8px; line-height: 1.5; }
        .review-date { font-size: 0.7rem; color: #718093; text-align: right; display: block; font-style: italic; }

        /* Empty State */
        .empty-state { text-align: center; padding: 40px; color: var(--text-muted); grid-column: 1 / -1; }
        .empty-state i { font-size: 3rem; margin-bottom: 15px; color: #3d3d4a; }

        /* Footer */
        footer {
            background: #0a0a0d; padding: 40px 20px; text-align: center; border-top: 1px solid var(--border-color); margin-top: 60px;
        }
        .footer-links { display: flex; justify-content: center; gap: 30px; margin-bottom: 20px; flex-wrap: wrap; }
        .footer-links a { color: var(--text-muted); transition: color 0.3s; }
        .footer-links a:hover { color: var(--primary); }
        .copyright { color: #555; font-size: 0.9rem; }

        /* FULL SCREEN MODAL DESIGN */
        .modal-overlay {
            display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0, 0, 0, 0.95); backdrop-filter: blur(8px);
            z-index: 1000; justify-content: center; align-items: center; padding: 20px; overflow: hidden;
        }
        
        .modal-overlay.active { display: flex; }
        
        .modal-content {
            background: var(--modal-bg); border: 1px solid #3d3d4a; border-radius: 20px;
            width: 95vw; height: 95vh; overflow-y: auto; position: relative;
            animation: slideUp 0.3s ease; box-shadow: 0 25px 60px rgba(0,0,0,0.7);
            display: flex; flex-direction: column;
        }

        .modal-content::-webkit-scrollbar { width: 8px; }
        .modal-content::-webkit-scrollbar-track { background: transparent; }
        .modal-content::-webkit-scrollbar-thumb { background: #3d3d4a; border-radius: 10px; }
        .modal-content::-webkit-scrollbar-thumb:hover { background: var(--primary); }
        
        @keyframes slideUp { from { transform: translateY(40px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
        
        .modal-header {
            padding: 25px 40px; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center; 
            position: sticky; top: 0; background: rgba(30, 30, 38, 0.95); backdrop-filter: blur(10px); z-index: 2; border-radius: 20px 20px 0 0;
        }
        
        .modal-header h3 { color: var(--primary); font-size: 2.5rem; font-weight: 800; letter-spacing: -0.5px; }
        
        .close-btn {
            background: rgba(255,255,255,0.05); border: none; color: var(--text-muted); width: 45px; height: 45px; 
            border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; cursor: pointer; transition: all 0.3s;
        }
        .close-btn:hover { background: rgba(255, 71, 87, 0.2); color: var(--primary); transform: rotate(90deg); }
        
        .modal-body { padding: 40px; flex-grow: 1; }
        .modal-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; height: 100%; }

        @media (max-width: 900px) {
            .modal-grid { grid-template-columns: 1fr; gap: 30px; height: auto; }
            .modal-content { width: 100%; height: 100%; border-radius: 0; }
            .modal-header { padding: 20px; }
            .modal-body { padding: 20px; }
            .modal-header h3 { font-size: 1.8rem; }
        }

        /* Left side: Menu */
        .menu-section h4, .map-section h4 {
            color: var(--text-light); margin-bottom: 25px; font-size: 1.4rem; border-bottom: 2px solid var(--border-color); 
            padding-bottom: 15px; display: flex; align-items: center; gap: 10px; font-weight: 700;
        }

        .menu-item { display: flex; align-items: center; gap: 15px; padding: 15px 0; border-bottom: 1px dashed var(--border-color); }
        .menu-item:last-child { border-bottom: none; }

        .menu-item-img {
            width: 70px; height: 70px; border-radius: 10px; background-size: cover; background-position: center;
            flex-shrink: 0; border: 1px solid var(--border-color);
        }

        .menu-item-details { flex-grow: 1; }
        .menu-item-info h5 { font-size: 1.1rem; margin-bottom: 3px; color: #fff; font-weight: 600; }
        .menu-item-info p { font-size: 0.85rem; color: var(--text-muted); }
        .menu-item-price { color: var(--primary); font-weight: 800; font-size: 1.2rem; }

        /* Right side: Map */
        .location-details { margin-bottom: 20px; padding: 20px; background: #141419; border-radius: 12px; border: 1px solid var(--border-color); }
        .location-details p { font-size: 1.1rem; margin-bottom: 5px; }
        .location-details strong { color: var(--primary); font-size: 1.2rem; }
        
        .map-container {
            width: 100%; height: 55vh; border-radius: 15px; overflow: hidden; border: 2px solid #3d3d4a; 
            box-shadow: 0 10px 30px rgba(0,0,0,0.6); position: relative;
        }
        .map-container iframe { width: 100%; height: 100%; border: none; }

        .action-buttons { display: flex; gap: 15px; margin-top: 15px; }

        .btn-google-maps {
            flex: 1; display: flex; align-items: center; justify-content: center; gap: 10px;
            padding: 15px; background: var(--primary); color: white; border-radius: 12px; 
            font-weight: 600; font-size: 1rem; text-decoration: none; transition: 0.3s; border: none; cursor: pointer;
        }
        .btn-google-maps:hover { background: #e03e50; transform: translateY(-2px); box-shadow: 0 5px 15px rgba(255, 71, 87, 0.4); }

        .btn-exact-location {
            display: flex; align-items: center; justify-content: center; gap: 10px;
            padding: 15px; background: #141419; color: var(--text-light); border-radius: 12px; 
            font-weight: 600; font-size: 1rem; text-decoration: none; transition: 0.3s; border: 1px solid var(--primary); cursor: pointer;
        }
        .btn-exact-location:hover { background: rgba(255, 71, 87, 0.1); color: var(--primary); }
    </style>
</head>
<body>

    <nav class="navbar">
        <h2>🍔 Kabankalan Eats</h2>
        <div class="nav-actions">
            <a href="#" class="nav-icon"><i class="fas fa-search"></i></a>
            <a href="#" class="nav-icon">
                <i class="fas fa-shopping-cart"></i>
                <span class="cart-badge">2</span>
            </a>
            <a href="#" class="nav-icon"><i class="fas fa-user-circle"></i></a>
        </div>
    </nav>

    <main class="container">
        
        <div class="hero" id="heroSection">
            <h1>Discover the Best Food</h1>
            <p>Search for local restaurants, dishes, and cuisines within <strong>Kabankalan City Proper</strong> only.</p>
            <div class="search-box">
                <input type="text" id="searchInput" placeholder="Search food, drinks, or restaurants...">
                <button type="button" id="searchBtn">Search</button>
            </div>
        </div>

        <div id="categoriesSection">
            <h2 class="section-title"><i class="fas fa-utensils" style="color: var(--primary);"></i> Explore Categories</h2>
            <div class="categories" id="category-list">
                <button class="cat-btn" data-category="fastfood"><i class="fas fa-burger"></i> Fast Food</button>
                <button class="cat-btn active" data-category="carinderia"><i class="fas fa-bowl-rice"></i> Local & Cansi</button>
                <button class="cat-btn" data-category="cafe"><i class="fas fa-mug-hot"></i> Cafe & Snacks</button>
                <button class="cat-btn" data-category="desserts"><i class="fas fa-ice-cream"></i> Desserts</button>
                <button class="cat-btn" data-category="milktea"><i class="fas fa-coffee"></i> Milk Tea</button>
            </div>
        </div>

        <div class="content-split">
            
            <div id="trendingSection">
                <h2 class="section-title" id="trending-title"><i class="fas fa-fire" style="color: #e67e22;"></i> Trending</h2>
                <div class="trending-grid" id="trending-grid"></div>
            </div>

            <div>
                <h2 class="section-title" id="category-title"><i class="fas fa-list" style="color: var(--primary);"></i> All Local & Cansi</h2>
                <div class="all-grid" id="all-restaurants-grid"></div>
            </div>

        </div>

        <!-- SYSTEM FEEDBACK SECTION -->
        <div class="reviews-container">
            <h2 class="section-title" style="margin-top: 0; margin-bottom: 5px; font-size: 1.3rem;"><i class="fas fa-star" style="color: #f1c40f;"></i> System Feedback</h2>
            <p style="text-align: center; color: var(--text-muted); margin-bottom: 20px; font-size: 0.8rem;">
                Kamusta ang experience? I-rate at mag-iwan ng komento.
            </p>

            <form class="review-form" id="reviewForm">
                <div class="form-row">
                    <input type="text" id="reviewName" placeholder="Iyong Pangalan" required style="flex: 1; min-width: 150px;">
                    
                    <select id="reviewRating" required style="flex: 1; min-width: 150px;">
                        <option value="5">⭐⭐⭐⭐⭐ (Excellent)</option>
                        <option value="4">⭐⭐⭐⭐ (Very Good)</option>
                        <option value="3">⭐⭐⭐ (Good)</option>
                        <option value="2">⭐⭐ (Fair)</option>
                        <option value="1">⭐ (Poor)</option>
                    </select>
                </div>
                
                <textarea id="reviewText" placeholder="Isulat ang comment dito..." required></textarea>
                
                <button type="submit" id="submitBtn" class="btn-primary">
                    <i class="fas fa-paper-plane"></i> Submit Feedback
                </button>
            </form>

            <div class="review-list" id="reviewList">
                <div class="review-item">
                    <div class="review-header">
                        <span class="review-name">sayoi</span>
                        <span class="review-stars">⭐⭐⭐⭐⭐</span>
                    </div>
                    <p class="review-text">Naminami!</p>
                    <span class="review-date">November 12, 2026</span>
                </div>
                <div class="review-item">
                    <div class="review-header">
                        <span class="review-name">Argie Salgado</span>
                        <span class="review-stars">⭐⭐⭐⭐⭐</span>
                    </div>
                    <p class="review-text">Napaka-user-friendly ng system! Makikita mo agad kung saan ang mga sikat na kainan sa Kabankalan.</p>
                    <span class="review-date">November 10, 2026</span>
                </div>
            </div>
        </div>

    </main>

    <footer>
        <div class="footer-links">
            <a href="#">About Us</a>
            <a href="#">Contact Us</a>
            <a href="#">Help</a>
        </div>
        <p class="copyright">&copy; 2026 Kabankalan Eats. All rights reserved.</p>
    </footer>

    <!-- FULL SCREEN MENU AT MAP MODAL -->
    <div class="modal-overlay" id="infoModal">
        <div class="modal-content">
            <div class="modal-header">
                <h3 id="modalRestaurantName">Restaurant Name</h3>
                <button class="close-btn" onclick="closeModal()"><i class="fas fa-times"></i></button>
            </div>
            <div class="modal-body">
                <div class="modal-grid">
                    
                    <div class="menu-section">
                        <h4><i class="fas fa-utensils" style="color: var(--primary);"></i> Menu</h4>
                        <div id="modalMenuList"></div>
                    </div>

                    <div class="map-section">
                        <h4><i class="fas fa-map-marker-alt" style="color: var(--primary);"></i> Location</h4>
                        <div class="location-details">
                            <p><strong id="modalAddress">Address here</strong></p>
                            <p style="color: var(--text-muted); font-size: 0.85rem;">Kabankalan City Proper</p>
                        </div>
                        
                        <div class="map-container">
                            <iframe id="mapFrame" src="" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                        </div>
                        
                        <div class="action-buttons">
                            <a href="#" id="mapBadgeLink" target="_blank" class="btn-exact-location">
                                <i class="fas fa-map-pin"></i> Exact Location
                            </a>
                            <a href="#" id="openMapsBtn" target="_blank" class="btn-google-maps">
                                <i class="fas fa-directions"></i> Open in Maps
                            </a>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <!-- JAVASCRIPT (DINAGDAGAN NG MGA KAINAN SA KABANKALAN PROPER) -->
    <script>
        const foodData = {
            fastfood: [
                { name: "Jollibee (Guanzon)", mapQuery: "Jollibee+Guanzon+St+Kabankalan", rating: "4.5", price: "₱100–₱200", img: "https://images.unsplash.com/photo-1568901346375-23c9450c58cd?q=80&w=800&auto=format&fit=crop", address: "Guanzon St, Kabankalan City Proper", menu: [
                    { name: "Chickenjoy", price: "₱99", desc: "Crispy fried chicken", img: "https://images.unsplash.com/photo-1626082927389-6cd097cdc6ec?q=80&w=200&auto=format&fit=crop" }, 
                    { name: "Yumburger", price: "₱45", desc: "Classic burger", img: "https://images.unsplash.com/photo-1568901346375-23c9450c58cd?q=80&w=200&auto=format&fit=crop" }
                ]},
